{
  "name": "akthar-world",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Akthar's World: a pixel-art portfolio you can walk around in.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/check-map.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:map": "node tools/check-map.ts",
    "tiles": "python3 tools/make_custom_tiles.py"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
